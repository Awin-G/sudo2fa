# Contributor: awinx

pkgname=sudo2fa-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Dependency-free, setuid-aware TOTP authorization helper for headless Linux (AI agents, remote shells, systemd services)"
arch=('x86_64')
url="https://github.com/Awin-G/sudo2fa"
license=('MIT')
depends=()
makedepends=('cargo' 'git')
provides=('sudo2fa')
conflicts=('sudo2fa')
source=("sudo2fa::git+https://github.com/Awin-G/sudo2fa.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/sudo2fa"
    # VCS guideline: prefer the most recent annotated tag; fall back to a
    # monotonic revision count + short hash when no tag exists yet.
    ( set -o pipefail
      git describe --long --abbrev=7 2>/dev/null | sed 's/\([^-]*-g\)/r\1/;s/-/./g' ||
      printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
    )
}

build() {
    cd "$srcdir/sudo2fa"
    cargo build --release --locked
}

package() {
    cd "$srcdir/sudo2fa"
    install -Dm4755 -o root -g root target/release/sudo2fa \
        "$pkgdir/usr/bin/sudo2fa"
}
